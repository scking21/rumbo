{
  "name": "rumbo-openai-sites-candidate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "bash scripts/build.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "pretest": "node scripts/assets.mjs && node scripts/verify-oracle.mjs && npm run build",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "miniflare": "4.20260730.0"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.0"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
