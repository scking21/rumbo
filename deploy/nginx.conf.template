pid /tmp/nginx.pid;
worker_processes auto;
error_log /dev/null crit;
events { worker_connections 256; }
http {
    # Raw URIs may contain OAuth authorization codes. No request/body/header logs.
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 1m;
    client_body_buffer_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 15s;
    limit_req_zone $binary_remote_addr zone=perip:10m rate=5r/s;
    limit_req_zone $server_name zone=global_rate:1m rate=30r/s;
    limit_req_zone $binary_remote_addr zone=login:1m rate=6r/m;
    limit_conn_zone $server_name zone=global_connections:1m;
    limit_req_status 429;
    limit_conn_status 429;
    upstream rumbo_backend { server app:8765; }
    server {
        listen 8443 ssl;
        server_name __APP_HOST__;
        if ($host != "__APP_HOST__") { return 421; }
        ssl_certificate /run/tls/fullchain.pem;
        ssl_certificate_key /run/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        limit_req zone=perip burst=10 nodelay;
        limit_req zone=global_rate burst=20 nodelay;
        limit_conn global_connections 32;
        add_header Strict-Transport-Security "max-age=31536000" always;
        location ^~ /health/ { return 404; }
        location = /.well-known/openai-apps-challenge {
            default_type text/plain;
            alias /run/challenge/openai-apps-challenge;
        }
        location = /owner/login {
            limit_req zone=login burst=3 nodelay;
            limit_req zone=global_rate burst=20 nodelay;
            proxy_pass http://rumbo_backend;
            proxy_set_header Host __APP_HOST__;
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header Connection "";
            proxy_http_version 1.1;
            proxy_connect_timeout 5s;
            proxy_read_timeout 30s;
            proxy_send_timeout 15s;
            proxy_buffering off;
        }
        location / {
            proxy_pass http://rumbo_backend;
            proxy_set_header Host __APP_HOST__;
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header Connection "";
            proxy_http_version 1.1;
            proxy_connect_timeout 5s;
            proxy_read_timeout 30s;
            proxy_send_timeout 15s;
            proxy_buffering off;
        }
    }
}
