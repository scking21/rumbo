{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/record.py\" show --record \"${CLAUDE_PROJECT_DIR}/.rumbo/record.json\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/record.py\" stop-gate --record \"${CLAUDE_PROJECT_DIR}/.rumbo/record.json\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
